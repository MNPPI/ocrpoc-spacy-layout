{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": ".repomix/context.xml",
    "style": "xml",
    "compress": true,
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": ["htmlcov/**", "data/**"],
  },
  "security": {
    "enableSecurityCheck": true,
  },
}
